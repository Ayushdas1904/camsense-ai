# ── CamSense AI · AI service environment ──────────────────────────
# Copy to `.env` and adjust. Never commit the real .env.
# All keys use the AI_SERVICE_ prefix (see app/config.py).

AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# demo = process sample videos; real = process RTSP/IP camera streams.
# The foundation ships with mock detectors regardless of mode.
AI_SERVICE_DETECTION_MODE=demo

# Allowed origins that may call the AI service directly (normally only the
# Node backend; the frontend should NOT call this service directly).
AI_SERVICE_ALLOWED_ORIGINS=http://127.0.0.1:5000

# Model paths (used once real YOLO/face models are added in later reviews)
# YOLO_MODEL_PATH=models/yolov8n.pt
