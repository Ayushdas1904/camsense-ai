# ── CamSense AI · AI service environment ──────────────────────────
# Copy to `.env` and adjust. Never commit the real .env.
# All keys use the AI_SERVICE_ prefix (see app/config.py).

AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# demo = process the bundled sample video; real = open a camera stream URL.
AI_SERVICE_DETECTION_MODE=demo
AI_SERVICE_ALLOWED_ORIGINS=http://127.0.0.1:5050

# Model & detection
AI_SERVICE_MODEL_PATH=../models/yolov8n.pt
AI_SERVICE_PERSON_CONFIDENCE=0.50
AI_SERVICE_WEAPON_CONFIDENCE=0.65
AI_SERVICE_SAMPLE_VIDEO=samples/vtest.avi

# Processing performance
AI_SERVICE_TARGET_FPS=8
AI_SERVICE_FRAME_WIDTH=640
AI_SERVICE_JPEG_QUALITY=70

# Reporting detections back to the Node backend (service-to-service)
AI_SERVICE_BACKEND_URL=http://127.0.0.1:5050
AI_SERVICE_INGEST_SECRET=local_dev_ingest_secret_change_me
AI_SERVICE_REPORT_INTERVAL=1.0
