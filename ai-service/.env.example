# ── CamSense AI · AI service environment ──────────────────────────
# Copy to `.env` and adjust. Never commit the real .env.
# All keys use the AI_SERVICE_ prefix (see app/config.py).

# Bind address. LOOPBACK BY DEFAULT: this service holds the face models and
# returns face embeddings to its one caller (the Node backend), so it must not
# listen on every interface. Only widen this when the deployment needs it — for
# example inside a container whose ports are published to 127.0.0.1 — and keep
# AI_SERVICE_INGEST_SECRET set either way.
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000

# demo = process the bundled sample video; real = open a camera stream URL.
AI_SERVICE_DETECTION_MODE=demo
AI_SERVICE_ALLOWED_ORIGINS=http://127.0.0.1:5050

# Model & detection
AI_SERVICE_MODEL_PATH=../models/yolov8n.pt
AI_SERVICE_PERSON_CONFIDENCE=0.50
AI_SERVICE_WEAPON_CONFIDENCE=0.65
AI_SERVICE_SAMPLE_VIDEO=samples/vtest.avi

# Processing performance
AI_SERVICE_TARGET_FPS=8
AI_SERVICE_FRAME_WIDTH=640
AI_SERVICE_JPEG_QUALITY=70

# Reporting detections back to the Node backend (service-to-service)
AI_SERVICE_BACKEND_URL=http://127.0.0.1:5050
# Shared service secret. It authenticates BOTH directions: this service sends
# it when reporting to the backend, and REQUIRES it on every one of its own
# routes except /api/health (including /api/faces/register, which returns a
# face embedding). It MUST equal AI_INGEST_SECRET in backend/.env, or the two
# services cannot talk to each other. THERE IS NO DEFAULT VALUE: if this is
# unset the service rejects every request with a 503 naming this variable,
# which is the fail-closed behaviour — a default could never match the
# backend's. Never commit a real value.
AI_SERVICE_INGEST_SECRET=replace_with_a_shared_secret
AI_SERVICE_REPORT_INTERVAL=1.0
AI_SERVICE_RECOGNITION_REPORT_INTERVAL=1.0
# HTTP timeout (seconds) for reporting to the backend. The POST runs on a
# background thread, so this never delays frame processing.
AI_SERVICE_REPORT_TIMEOUT=2.0

# ── Face detection & recognition (Review 2) ───────────────────────
# No extra pip package is needed: both models are ONNX files run through the
# already-installed opencv-python-headless. Fetch them with:
#   python download_assets.py
AI_SERVICE_FACE_DETECTION_MODEL_PATH=../models/face_detection_yunet_2023mar.onnx
AI_SERVICE_FACE_RECOGNITION_MODEL_PATH=../models/face_recognition_sface_2021dec.onnx
AI_SERVICE_FACE_DETECTION_CONFIDENCE=0.80

# Cosine-similarity threshold for declaring a face KNOWN.
# 0.363 is OpenCV's published starting point for SFace — it is NOT a calibrated
# or universal value. Validate it against your own enrolled people and cameras
# and tune it here. A similarity score is not a probability.
AI_SERVICE_FACE_MATCH_THRESHOLD=0.363

# Faces smaller than this (pixels, shortest side) are reported LOW_QUALITY
# instead of being matched.
AI_SERVICE_FACE_MIN_SIZE=60

# Recognition runs on every Nth processed frame (object detection still runs on
# every processed frame).
AI_SERVICE_FACE_RECOGNITION_EVERY_N_FRAMES=3

# A registration photograph must contain exactly this many faces.
AI_SERVICE_FACE_REGISTRATION_MAX_FACES=1

# Enrolled-identity cache: seconds before refetching, and where to fetch from
# (blank → use AI_SERVICE_BACKEND_URL, which is the only holder of embeddings).
AI_SERVICE_EMBEDDING_CACHE_TTL=60.0
AI_SERVICE_EMBEDDING_SOURCE_URL=

# Extra seconds past the TTL before a cache that keeps failing to refresh is
# treated as untrustworthy. Staleness is measured from the last SUCCESSFUL
# load, not the last attempt, so a refresh that keeps failing really does age
# the cache out. After TTL + grace, matching FAILS CLOSED
# (RECOGNITION_UNAVAILABLE) rather than scoring against an identity set that
# may still contain a person who has since been disabled or deleted. A cache
# the backend has told us changed is distrusted immediately, without waiting
# for the TTL.
AI_SERVICE_EMBEDDING_CACHE_STALE_GRACE=30.0

# HTTP timeout (seconds) for fetching the enrolled identities. The fetch runs
# on a background thread, so it never delays frame processing.
AI_SERVICE_EMBEDDING_FETCH_TIMEOUT=3.0
