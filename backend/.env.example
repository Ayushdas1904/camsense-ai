# ── CamSense AI · Backend environment ─────────────────────────────
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.

# Server
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/camsense

# JWT auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Default admin seed (used by `npm run seed`)
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@camsense.ai
SEED_ADMIN_PASSWORD=ChangeMe123!

# AI service (Python FastAPI) — backend calls this, frontend never does
AI_SERVICE_URL=http://127.0.0.1:8000
