# ── CamSense AI · Backend environment ─────────────────────────────
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.

# Server
NODE_ENV=development
PORT=5000
# Bind address. LOOPBACK BY DEFAULT — this process serves snapshot images and
# enrolled people's registration portraits behind JWT auth, so it should not
# listen on every interface unless a deployment genuinely needs it.
HOST=127.0.0.1

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/camsense

# JWT auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Lifetime of the NARROWED token used in /uploads image URLs. An <img> tag
# cannot send an Authorization header, so that credential travels in the URL
# (and into browser history and any fronting proxy's log); it is therefore
# scoped to image reads only and expires sooner than the session. Shortening it
# is safe — the only cost is that a long-open tab must be reloaded for images.
ASSET_TOKEN_EXPIRES_IN=1d

# Default admin seed (used by `npm run seed`)
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@camsense.ai
SEED_ADMIN_PASSWORD=ChangeMe123!

# AI service (Python FastAPI) — backend calls this, frontend never does
AI_SERVICE_URL=http://127.0.0.1:8000

# Shared secret for AI service → backend event ingestion AND for the backend's
# own calls to the AI service (every AI-service route except /api/health
# requires it). MUST match the ai-service AI_SERVICE_INGEST_SECRET value.
# NEITHER SIDE HAS A DEFAULT: unset means both fail closed with a message
# naming this variable, rather than 401ing every call with a default that could
# never match. Set it yourself; never commit a real value.
AI_INGEST_SECRET=replace_with_a_shared_secret

# Detection snapshots and registration portraits (stored on disk, referenced by
# URL, and served ONLY through the authenticated /uploads mount).
SNAPSHOT_DIR=uploads/snapshots

# Alert / detection throttling (seconds) — prevents duplicate spam across frames
DETECTION_EVENT_COOLDOWN=5
WEAPON_ALERT_COOLDOWN=10
PERSON_ALERT_COOLDOWN=60

# ── Review 2 · face recognition & attendance ──────────────────────
# Cosine-similarity threshold an identity claim must clear before the backend
# accepts it. 0.363 is OpenCV's published STARTING POINT for the SFace model:
# it requires validation on your own enrolled data and is meant to be tuned.
# A cosine similarity is NOT a calibrated probability.
RECOGNITION_MATCH_THRESHOLD=0.363

# Temporal verification before an unknown-identity alert is raised: the same
# camera + face track must be observed UNKNOWN_PERSISTENCE_COUNT times within
# UNKNOWN_PERSISTENCE_WINDOW seconds.
UNKNOWN_PERSISTENCE_COUNT=2
UNKNOWN_PERSISTENCE_WINDOW=10

# Per-camera/track cooldown (seconds) so one continuously visible unmatched
# face produces one alert rather than one per frame.
UNKNOWN_ALERT_COOLDOWN=60

# Per-camera/person cooldown (seconds) for STORED 'known' recognition events
# and their socket emits. Without it, one recognised person standing in view
# writes one event per recognition report (~1/s/camera) indefinitely.
KNOWN_EVENT_COOLDOWN=30

# Minimum gap (seconds) between lastSeen writes for an already-marked person.
ATTENDANCE_UPDATE_COOLDOWN=30

# Embedding dimension the configured recognition model produces (SFace = 128).
# Checked at the trust boundary so a vector from another embedding space is
# rejected rather than scored.
RECOGNITION_EMBEDDING_DIM=128

# Seconds the "is anybody enrolled?" count is cached for. With nobody
# enrolled, unknown-identity alerts are suppressed entirely — every face would
# otherwise alert on a freshly deployed system.
ENROLLED_COUNT_TTL=30

# Maximum decoded size of a registration photograph, in bytes (5 MB).
FACE_UPLOAD_MAX_BYTES=5000000

# ── Review 3 · occupancy monitoring ──────────────────────────────
# Occupancy is derived from the EXISTING YOLO human detections (no second
# model). These knobs govern how the backend trusts, stores and alerts on the
# figures the AI service reports.

# Seconds after which a reported occupancy figure is treated as STALE and stops
# being shown as current. A stale or unavailable figure is reported with a NULL
# count, never 0 — "we cannot tell" is not "the room is empty".
OCCUPANCY_STALE_AFTER=30

# Minimum seconds between occupancy HISTORY writes for the same room when
# nothing has changed. A change in count, status or availability always writes
# immediately; this is the heartbeat that keeps a steady room readable without
# writing one row per processed frame.
OCCUPANCY_PERSIST_INTERVAL=60

# Per-room cooldown (seconds) for near-capacity / capacity-exceeded alerts, so
# one busy room produces one alert rather than one per report.
OCCUPANCY_ALERT_COOLDOWN=300

# Hard ceiling on the GET /api/occupancy/history page size, so no request can
# produce an unbounded query.
OCCUPANCY_HISTORY_MAX_LIMIT=500

# Default fraction of a room's capacity at which the status becomes "Near
# Capacity". A room may override it. Ignored for a room with no configured
# capacity, since a ratio of an unknown capacity means nothing.
OCCUPANCY_NEAR_CAPACITY_RATIO=0.8

# ── Review 3 · device control ────────────────────────────────────
# ONLY THE SIMULATION ADAPTER IS IMPLEMENTED in this project. There is no
# MQTT, ESP32 or relay-board integration, and none is stubbed — a device
# configured for any other adapter type has its commands REFUSED with a clear
# error rather than silently simulated. Simulated devices are labelled as
# simulated in every API response and every socket event.

# Seconds an adapter call may take before it is treated as FAILED. The
# simulation adapter is synchronous and never reaches this; the timeout is
# passed through the adapter contract so a future real adapter inherits a
# bound instead of hanging the automation tick.
DEVICE_COMMAND_TIMEOUT=5

# Minimum seconds between two `device_failure` alerts for the SAME device. A
# device whose adapter keeps refusing is re-commanded on every engine tick, so
# without this one ongoing fault would raise an alert every tick. Each failure
# is still recorded in full in the device history and the automation log; only
# the duplicate alert is suppressed.
DEVICE_FAILURE_ALERT_COOLDOWN=300

# ── Review 3 · occupancy-based automation ────────────────────────
# NOTHING HERE ENABLES AUTOMATION. A rule must be explicitly enabled
# (new rules are created disabled) AND the device must be in 'automatic'
# control mode (devices are created 'disabled') before a single command is
# issued. These are only the defaults offered when a rule is created.

# How often the engine re-evaluates rules on its own, in seconds. The engine is
# primarily EVENT-DRIVEN — it runs after every accepted occupancy report — so
# this tick exists for the transitions that are caused by time passing rather
# than by a new report: an unoccupied delay maturing, a manual override
# expiring, and occupancy going stale. The last one matters most, because when
# a camera goes dark no report arrives at all.
AUTOMATION_TICK_INTERVAL=30

# Minimum seconds between commands to the SAME device. Together with the
# "already in the desired state" check in the rules module, this is what stops
# a device being flapped on and off.
AUTOMATION_COMMAND_COOLDOWN=60

# Default seconds a room must stay continuously at or below its occupancy
# threshold before it counts as unoccupied. Stops a short absence going dark.
AUTOMATION_DEFAULT_UNOCCUPIED_FOR=300

# Default lifetime of a manual override, in minutes. While an override is
# unexpired, automation records 'skipped_override' and issues no command, so an
# operator's action is never immediately undone. Every override carries its own
# explicit expiry, after which automatic control resumes by itself.
AUTOMATION_MANUAL_OVERRIDE_MINUTES=30

# Hard ceiling on the GET /api/automation/history page size.
AUTOMATION_HISTORY_MAX_LIMIT=500

# Minimum seconds between two `automation_failure` alerts. The engine ticks
# continuously, so a persistent fault would otherwise raise one alert per tick.
# Every failure is still logged and reported by GET /api/health/components.
AUTOMATION_FAILURE_ALERT_COOLDOWN=300

# ── Review 3 · energy analytics ──────────────────────────────────
# EVERY ENERGY FIGURE THIS PROJECT REPORTS IS AN ESTIMATE. There is no power
# meter: energy is (the power rating you configure on a device) × (the duration
# the device was recorded on), so kWh inherits the accuracy of a typed-in
# number. Every energy API response is labelled estimated: true, and
# simulated: true whenever a simulated device contributed.

# THE DECLARED BASELINE, and the only reason a savings figure can be quoted at
# all: the hours per day a device would have run under its configured operating
# schedule WITHOUT occupancy-based switching. Savings are baseline minus
# estimated actual consumption, clamped at zero and pro-rated for windows
# shorter than a day. IT IS AN ASSUMPTION, NOT A MEASUREMENT — set it to match
# the schedule you are actually comparing against, and quote it whenever you
# quote a saving. It is returned inside every energy response for that reason,
# and the savings percentage is reported as null when the baseline is 0 rather
# than as a fabricated number.
ENERGY_BASELINE_HOURS_PER_DAY=12

# Hard ceiling on the energy history page size, and on how many device-state
# transitions a single window may pull, so no energy query is unbounded.
ENERGY_HISTORY_MAX_LIMIT=500
