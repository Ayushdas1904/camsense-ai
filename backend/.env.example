# ── CamSense AI · Backend environment ─────────────────────────────
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.

# Server
NODE_ENV=development
PORT=5000
# Bind address. LOOPBACK BY DEFAULT — this process serves snapshot images and
# enrolled people's registration portraits behind JWT auth, so it should not
# listen on every interface unless a deployment genuinely needs it.
HOST=127.0.0.1

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/camsense

# JWT auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Lifetime of the NARROWED token used in /uploads image URLs. An <img> tag
# cannot send an Authorization header, so that credential travels in the URL
# (and into browser history and any fronting proxy's log); it is therefore
# scoped to image reads only and expires sooner than the session. Shortening it
# is safe — the only cost is that a long-open tab must be reloaded for images.
ASSET_TOKEN_EXPIRES_IN=1d

# Default admin seed (used by `npm run seed`)
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@camsense.ai
SEED_ADMIN_PASSWORD=ChangeMe123!

# AI service (Python FastAPI) — backend calls this, frontend never does
AI_SERVICE_URL=http://127.0.0.1:8000

# Shared secret for AI service → backend event ingestion AND for the backend's
# own calls to the AI service (every AI-service route except /api/health
# requires it). MUST match the ai-service AI_SERVICE_INGEST_SECRET value.
# NEITHER SIDE HAS A DEFAULT: unset means both fail closed with a message
# naming this variable, rather than 401ing every call with a default that could
# never match. Set it yourself; never commit a real value.
AI_INGEST_SECRET=replace_with_a_shared_secret

# Detection snapshots and registration portraits (stored on disk, referenced by
# URL, and served ONLY through the authenticated /uploads mount).
SNAPSHOT_DIR=uploads/snapshots

# Alert / detection throttling (seconds) — prevents duplicate spam across frames
DETECTION_EVENT_COOLDOWN=5
WEAPON_ALERT_COOLDOWN=10
PERSON_ALERT_COOLDOWN=60

# ── Review 2 · face recognition & attendance ──────────────────────
# Cosine-similarity threshold an identity claim must clear before the backend
# accepts it. 0.363 is OpenCV's published STARTING POINT for the SFace model:
# it requires validation on your own enrolled data and is meant to be tuned.
# A cosine similarity is NOT a calibrated probability.
RECOGNITION_MATCH_THRESHOLD=0.363

# Temporal verification before an unknown-identity alert is raised: the same
# camera + face track must be observed UNKNOWN_PERSISTENCE_COUNT times within
# UNKNOWN_PERSISTENCE_WINDOW seconds.
UNKNOWN_PERSISTENCE_COUNT=2
UNKNOWN_PERSISTENCE_WINDOW=10

# Per-camera/track cooldown (seconds) so one continuously visible unmatched
# face produces one alert rather than one per frame.
UNKNOWN_ALERT_COOLDOWN=60

# Per-camera/person cooldown (seconds) for STORED 'known' recognition events
# and their socket emits. Without it, one recognised person standing in view
# writes one event per recognition report (~1/s/camera) indefinitely.
KNOWN_EVENT_COOLDOWN=30

# Minimum gap (seconds) between lastSeen writes for an already-marked person.
ATTENDANCE_UPDATE_COOLDOWN=30

# Embedding dimension the configured recognition model produces (SFace = 128).
# Checked at the trust boundary so a vector from another embedding space is
# rejected rather than scored.
RECOGNITION_EMBEDDING_DIM=128

# Seconds the "is anybody enrolled?" count is cached for. With nobody
# enrolled, unknown-identity alerts are suppressed entirely — every face would
# otherwise alert on a freshly deployed system.
ENROLLED_COUNT_TTL=30

# Maximum decoded size of a registration photograph, in bytes (5 MB).
FACE_UPLOAD_MAX_BYTES=5000000
