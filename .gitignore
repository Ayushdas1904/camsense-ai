# Dependencies
node_modules/
**/node_modules/
.venv/
**/.venv/

# Env files (never commit real secrets)
.env
**/.env

# Build output
dist/
**/dist/

# Python
__pycache__/
**/__pycache__/
*.pyc

# Model weights (large binaries — added per review, keep out of git)
models/*.pt
models/*.onnx
models/*.weights

# Stored images (face images / biometric data — never commit)
# Detection snapshots and person registration portraits are written here at
# runtime; the directory itself is kept via its .gitkeep placeholder.
uploads/*
**/uploads/*
!**/uploads/.gitkeep

# Logs & OS
*.log
.DS_Store

# TypeScript incremental build info
*.tsbuildinfo
**/*.tsbuildinfo
